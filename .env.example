# ================================================================
# DISCORD TICKET BOT CONFIGURATION
# ================================================================

# [REQUIRED] Discord Bot Token from Discord Developer Portal
# Go to: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Target Server (Guild) ID for instant Slash Commands
GUILD_ID=1549490376195309661

# Support Staff Role ID
SUPPORT_ROLE_ID=1549492423326179458

# Ticket Category ID
TICKET_CATEGORY_ID=1549540319958147155

# Audit Log Channel ID (Private Staff Only)
LOG_CHANNEL_ID=1553102113268047874

# Transcript Channel ID (Private Staff Only)
TRANSCRIPT_CHANNEL_ID=1553102113268047874

# [DATABASE CONFIGURATION]
# SQLite default (runs locally with zero extra setup):
DATABASE_URL=sqlite:///tickets.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ticketbot

# [TICKET & REGISTRATION SETTINGS]
MAX_OPEN_TICKETS=1
# Format options: ticket-{id:06d} (e.g. ticket-000001) or ticket-{username}
TICKET_NAME_FORMAT=ticket-{id:06d}
AUTOREPLY_ENABLED=true
REQUIRE_REGISTRATION=true
REGISTERED_ROLE_ID=


# [WEB ADMIN DASHBOARD (OPTIONAL)]
ENABLE_DASHBOARD=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change_this_secure_password
